.venv/
venv/
__pycache__/
*.py[cod]
.pytest_cache/
# logs/ is deliberately tracked: the transcripts are what opponents.json is
# derived from, so without them a fresh clone can read the profiles but cannot
# rebuild or audit them.

# duel-a/ and duel-b/ are two of your own bots playing each other. They are not
# evidence about anybody's rival, which is the only thing logs/ is kept for.
duel-a/
duel-b/

# start scripts may embed your personal bot token
start.local.*
.env
