# Copy this file to .env and fill it in. Put real values in .env, never here:
# .env is gitignored, this template is not. Nothing in .env is ever printed or
# logged, and the session cookie is only ever sent back to the site it came from.

# The bot token, from the site: My Bots -> Show token. This is the only line
# `start.ps1` / `start.sh` need.
CODECHALLENGE_TOKEN=eyJ...

# Your sessionid browser cookie (F12 -> Application -> Cookies on the site).
# Only the panel's Challenge button needs it: the documented `challenge`
# websocket action has never started a match on this server, so the button
# drives the website's own form, which wants a logged-in session.
CODECHALLENGE_SESSION=

# Which of your bots the Challenge button plays as -- its name on the site, the
# same one the dropdown shows. Only matters once you have two of them online at
# the same time, otherwise the site picks whichever it lists first.
CODECHALLENGE_BOT=

# A second bot of your own, for `duel.ps1`: two of your bots online at once so
# there is someone to play when nobody else is around. Register it on the site
# (My Bots -> New bot) and give it its own token.
CODECHALLENGE_TOKEN_2=
CODECHALLENGE_BOT_2=
